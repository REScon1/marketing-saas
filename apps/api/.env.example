# Postgres (lokálně: scripts/test-db.sh start vypíše URL)
DATABASE_URL=postgres://postgres@localhost:54329/marketing_saas
# Testy (pokud chybí, testy si spustí lokální cluster přes scripts/test-db.sh)
TEST_DATABASE_URL=postgres://postgres@localhost:54329/marketing_saas_test

PORT=3001
# HOST=127.0.0.1
NODE_ENV=development
# Origin(y) webové aplikace, čárkou oddělené. V produkci povinné. Jiný Origin u POST = 403.
APP_ORIGIN=http://localhost:5173
# Za reverzní proxy (kvůli IP pro rate limit): TRUST_PROXY=true
TRUST_PROXY=false
# Spustit publikační worker přímo v procesu serveru (místo samostatného `pnpm worker`)
WORKER_IN_PROCESS=false

# AI asistent: bez klíče se použije šablonový asistent (bez AI)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Publikace: simulated (výchozí, nic se neposílá) | ayrshare (zatím jen stub)
PUBLISHER=simulated
AYRSHARE_API_KEY=

# Volitelná cesta ke sestavenému webu (výchozí apps/web/dist, pokud existuje)
# WEB_DIST=
